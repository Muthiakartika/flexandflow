# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
# Transient server output. `.devserver.log` was listed by name and `.prod.log`
# was not, so it got committed — the pattern covers whichever one comes next.
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the template, which carries no secrets and is the only record of
# which variables the app needs. `.env*` would otherwise hide it.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Prisma 7 emits the client into the repo; it is build output, not source.
/generated

# Client photo/video masters. Kept on disk, out of the repo: these are
# multi-megabyte camera originals, and the web-ready crops derived from them
# live in public/images/. Remove this line if you want them versioned.
/source-photos

# Uploads written by the CMS's local storage driver. Development only —
# `public/` is baked into the build, so these do not survive a deploy and are
# not the production path. See `lib/cms/storage.ts`.
/public/uploads

# The same driver, reached through the intake form: signatures
# (`lib/intake/signature.ts`) and IMAGE-field uploads (`lib/intake/uploads.ts`).
# Six test signatures were sitting untracked here on 2026-09-04, one `git add .`
# away from being committed — a client's signature is the last thing that
# should end up in version control by accident.
/public/intake-signatures
/public/intake-uploads

# One-off credential handovers written by `npm run admin:create`. Passwords in
# plain text: read it, pass it on, delete it.
.admin-accounts.txt

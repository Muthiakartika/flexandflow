# Booking system environment.
#
# Copy to `.env.local` for development and set the same keys in the Vercel
# project settings for production. `lib/env.ts` validates every one of these at
# first use and throws with the offending key named, so a missing value fails
# loudly instead of appearing as the string "undefined" inside a WAHA URL.

# ── Database ──────────────────────────────────────────────────────────────
# Neon. DATABASE_URL is the pooled connection the app runs on; DIRECT_URL
# bypasses PgBouncer and is what `prisma migrate` needs.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/flexandflow?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/flexandflow?sslmode=require"

# ── Email (SendGrid) ──────────────────────────────────────────────────────
# SENDGRID_FROM_EMAIL must sit on a domain authenticated in SendGrid. Sending
# as @gmail.com through SendGrid fails DMARC and lands in spam — the studio's
# Gmail address belongs in SENDGRID_REPLY_TO instead. See BOOKING-PLAN.md §6.2.
SENDGRID_API_KEY="SG.xxxxxxxx"
SENDGRID_FROM_EMAIL="booking@flexandflow.fit"
SENDGRID_FROM_NAME="Flex & Flow"
SENDGRID_REPLY_TO="Flexandflow06@gmail.com"
# Comma separated. Who receives the "new booking" email.
ADMIN_NOTIFY_EMAILS="Flexandflow06@gmail.com"

# ── WhatsApp (the studio's own WAHA server) ───────────────────────────────
# WAHA_BASE_URL must be reachable from Vercel over HTTPS. WAHA_SESSION is the
# name of the session already scanned and logged in on that server.
WAHA_BASE_URL="https://waha.example.com"
WAHA_API_KEY=""
WAHA_SESSION="default"
# Comma separated, E.164. Who receives the "new booking" WhatsApp.
ADMIN_WHATSAPP_NUMBERS="+6285858887777"

# ── Booking rules ─────────────────────────────────────────────────────────
BOOKING_TIMEZONE="Asia/Makassar"
# How far ahead of now a slot must be to remain bookable.
BOOKING_LEAD_TIME_MINUTES="120"
BOOKING_MAX_ADVANCE_DAYS="60"
# Granularity of candidate start times.
BOOKING_SLOT_STEP_MINUTES="30"
# Customers cannot cancel themselves inside this many hours of the session.
BOOKING_CANCEL_CUTOFF_HOURS="12"
# HMAC key for manage-booking and .ics links. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BOOKING_TOKEN_SECRET=""

# ── Admin & cron ──────────────────────────────────────────────────────────
# Signs the admin session cookie. Rotating it logs everyone out.
ADMIN_SESSION_SECRET=""
# Vercel Cron sends this as `Authorization: Bearer <value>`.
CRON_SECRET=""

# ── Seeding the first admin (seed script only) ────────────────────────────
# Read directly by `prisma/seed.ts`, not by `lib/env.ts` — the seed runs outside
# Next and cannot import a `server-only` module. Set them, run `npm run db:seed`
# once, then remove them; leaving a password in the environment is a standing
# risk for no ongoing benefit. Without them the seed skips the admin and says so.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME="Flex & Flow"

# ── Payments (Xendit) ─────────────────────────────────────────────────────
# Leave BOTH blank to run without online payment: the wizard then offers only
# "pay at the studio", which is the right state while the Xendit account is
# still being verified. Setting only one is refused — money that cannot be
# confirmed is worse than no payment at all.
#
# XENDIT_CALLBACK_TOKEN is the Callback Verification Token from the dashboard.
# Xendit does not sign callbacks; matching this token is the only proof a
# request came from them, so treat it like a password, never like a checksum.
XENDIT_SECRET_KEY=""
XENDIT_CALLBACK_TOKEN=""
# How long a charge stays payable. Must stay UNDER the booking hold (15 min),
# or someone can pay for a slot that has already been released.
XENDIT_INVOICE_MINUTES="13"

# ── Anti-spam (optional) ──────────────────────────────────────────────────
# Leave both blank to run without Turnstile; the widget and the server check
# are skipped together, so they can never disagree.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# ── Public ────────────────────────────────────────────────────────────────
# Absolute base for links in emails and WhatsApp messages.
NEXT_PUBLIC_SITE_URL="https://flexandflow.fit"

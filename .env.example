# Booking system environment.
#
# Copy to `.env.local` for development and set the same keys in the Vercel
# project settings for production. `lib/env.ts` validates every one of these at
# first use and throws with the offending key named, so a missing value fails
# loudly instead of appearing as the string "undefined" inside a WAHA URL.

# ── Database ──────────────────────────────────────────────────────────────
# Neon. DATABASE_URL is the pooled connection the app runs on; DIRECT_URL
# bypasses PgBouncer and is what `prisma migrate` needs.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/flexandflow?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/flexandflow?sslmode=require"

# ── Email (SendGrid) ──────────────────────────────────────────────────────
# SENDGRID_FROM_EMAIL must sit on a domain authenticated in SendGrid. Sending
# as @gmail.com through SendGrid fails DMARC and lands in spam — the studio's
# Gmail address belongs in SENDGRID_REPLY_TO instead. See BOOKING-PLAN.md §6.2.
SENDGRID_API_KEY="SG.xxxxxxxx"
SENDGRID_FROM_EMAIL="booking@flexandflow.fit"
SENDGRID_FROM_NAME="Flex & Flow"
SENDGRID_REPLY_TO="Flexandflow06@gmail.com"
# Comma separated. Who receives the "new booking" email.
ADMIN_NOTIFY_EMAILS="Flexandflow06@gmail.com"

# ── WhatsApp (the studio's own WAHA server) ───────────────────────────────
# WAHA_BASE_URL must be reachable from Vercel over HTTPS. WAHA_SESSION is the
# name of the session already scanned and logged in on that server.
WAHA_BASE_URL="https://waha.example.com"
WAHA_API_KEY=""
WAHA_SESSION="default"
# Comma separated, E.164. Who receives the "new booking" WhatsApp.
# A local "08…" number is accepted too and read as Indonesian (+62).
ADMIN_WHATSAPP_NUMBERS="+6285858887777"
# Extra numbers for the intake form only — a new client consent form, never a
# booking. Leave empty and only ADMIN_WHATSAPP_NUMBERS is notified. Put someone
# here rather than in the line above when they should not receive bookings.
INTAKE_WHATSAPP_NUMBERS=""

# ── Booking rules ─────────────────────────────────────────────────────────
BOOKING_TIMEZONE="Asia/Makassar"
# How far ahead of now a slot must be to remain bookable.
BOOKING_LEAD_TIME_MINUTES="120"
BOOKING_MAX_ADVANCE_DAYS="60"
# Granularity of candidate start times.
BOOKING_SLOT_STEP_MINUTES="30"
# Customers cannot cancel themselves inside this many hours of the session.
BOOKING_CANCEL_CUTOFF_HOURS="12"
# HMAC key for manage-booking and .ics links. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BOOKING_TOKEN_SECRET=""

# ── Admin & cron ──────────────────────────────────────────────────────────
# Signs the admin session cookie. Rotating it logs everyone out.
ADMIN_SESSION_SECRET=""
# Vercel Cron sends this as `Authorization: Bearer <value>`.
CRON_SECRET=""

# ── Seeding the first admin (seed script only) ────────────────────────────
# Read directly by `prisma/seed.ts`, not by `lib/env.ts` — the seed runs outside
# Next and cannot import a `server-only` module. Set them, run `npm run db:seed`
# once, then remove them; leaving a password in the environment is a standing
# risk for no ongoing benefit. Without them the seed skips the admin and says so.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME="Flex & Flow"

# ── Payments (Xendit) ─────────────────────────────────────────────────────
# Leave BOTH secrets blank to run without online payment: the wizard then offers
# only "pay at the studio", which is the right state while the Xendit account is
# still being verified. Setting only one is refused — money that cannot be
# confirmed is worse than no payment at all.
#
# PASTING THESE INTO A HOSTING DASHBOARD: paste the value only, without the
# quotes it is written with here. This file is read by dotenv, which strips
# surrounding quotes for you; Vercel and friends do not, so the quotes become
# part of the key. A trailing newline from a triple-click does the same. All of
# them come back from Xendit as `401 INVALID_API_KEY`, which points at the key
# rather than at its punctuation. (`lib/env.ts` now trims and unquotes these on
# the way in, so this is belt and braces rather than a trap — but the same
# mistake in a variable it does not clean will still bite.)
#
# There are four things to collect, and only two of them are variables. The
# other two are settings inside the Xendit dashboard, and the system does not
# work without them. PAYMENT-PLAN.md §9 walks through all four.

# 1. API secret key. Xendit dashboard → Settings → Developers → API Keys.
#    Create a key with write access to money-in, not a read-only one.
#    Test keys start `xnd_development_`, live keys `xnd_production_`. Use the
#    test key everywhere until the whole flow has been through the sandbox.
XENDIT_SECRET_KEY=""

# 2. Webhook verification token. Settings → Webhooks — Xendit renamed this from
#    "Callbacks", so older notes (and older Xendit docs) call it the Callback
#    Verification Token. Same thing. It sits on the same screen as the webhook
#    URLs, usually hidden behind a Show button, and there is a separate value
#    for Test and Live. Some accounts only reveal it once a first webhook URL
#    has been saved.
#
#    Xendit does NOT sign its webhooks — matching this token is the only proof
#    a request came from them. Treat it like a password, never like a checksum.
XENDIT_CALLBACK_TOKEN=""

# 2b. Public key. Same API Keys screen as the secret one, listed separately.
#     It reaches the browser on purpose — that is what lets the card form live
#     on our own page: Xendit.js swaps the card number for a token client-side,
#     so the number never touches this server. It can only tokenise, never
#     charge; moving money still needs the secret key.
#
#     Leave blank and the card option simply is not offered. QRIS and bank
#     transfer carry on regardless, which is the right way for this to degrade.
NEXT_PUBLIC_XENDIT_PUBLIC_KEY=""

# 3. NOT a variable: the webhook URL, registered on that same screen.
#    Set it to  https://flexandflow.fit/api/payments/xendit/  — WITH the
#    trailing slash. `trailingSlash: true` applies to route handlers, so the
#    slashless form answers 308, and a webhook sender that does not follow a
#    redirect on POST never reaches us. Set it for
#    EVERY payment event the studio accepts — invoices, virtual accounts, QR
#    codes and e-wallets each have their own row. One handler serves them all,
#    but a row left blank means those payments are collected and never
#    confirmed: the money arrives and the booking stays unpaid.
#
# 4. NOT a variable: the payment methods themselves, activated on the account —
#    QRIS, the virtual account banks, e-wallets, cards. A method that is not
#    switched on returns an error at charge time rather than at start-up.

# How long a charge stays payable. Must stay UNDER the booking hold (15 min),
# or someone can pay for a slot that has already been released.
XENDIT_INVOICE_MINUTES="13"

# ── Rate limits (optional) ────────────────────────────────────────────────
# Ceilings on how many bookings one phone or one address may make. The defaults
# below are the production ones; raise them on a staging deployment, where
# testing the payment flow means booking the same slot repeatedly and would
# otherwise trip the limit within minutes — which then reads as a gateway fault
# rather than as a limit doing its job.
#
# Holds the cron cancelled do not count: a customer whose payment lapsed is not
# a spammer, and the limit should be most patient with exactly that person.
BOOKING_MAX_PER_PHONE_HOUR="4"
BOOKING_MAX_PER_IP_10MIN="6"

# ── Anti-spam (optional) ──────────────────────────────────────────────────
# Leave both blank to run without Turnstile; the widget and the server check
# are skipped together, so they can never disagree.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# ── Public ────────────────────────────────────────────────────────────────
# Absolute base for links in emails and WhatsApp messages.
NEXT_PUBLIC_SITE_URL="https://flexandflow.fit"

# ── CMS media storage (optional; local disk is used when unset) ────────────
#
# Any S3-compatible endpoint. Configured for Cloudflare R2 behind a custom
# domain — see CMS-PLAN.md §10.1 for why the domain matters more than the
# provider: published articles store image URLs, and a URL on a hosting
# provider's own domain breaks every image in every article the day you move.
#
# With any of these unset the CMS writes uploads to `public/uploads/` and
# serves them root-relative, which is what development uses. That is fine
# locally and wrong in production: `public/` is baked into the build, so an
# upload made on a deployed server disappears at the next deploy.
MEDIA_S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
MEDIA_S3_BUCKET="flexandflow-media"
MEDIA_S3_ACCESS_KEY_ID=""
MEDIA_S3_SECRET_ACCESS_KEY=""
# R2 ignores this but the AWS SDK insists on one.
MEDIA_S3_REGION="auto"
# The public base for stored URLs. Point a custom domain at the bucket and put
# it here; without one the URLs carry the provider's hostname and stop being
# yours. Must have no trailing slash.
MEDIA_PUBLIC_BASE="https://media.flexandflow.fit"

# ── Cloudflare cache purge (optional; the site works without it) ──────────
#
# The domain is proxied through Cloudflare, in front of Vercel, and the HTML
# goes out `cache-control: public, max-age=7200`. A deploy changes what the
# origin serves and nothing about the copy Cloudflare is already handing to
# visitors — so without a purge a release takes up to two hours to appear, at a
# different moment in every colo. `.github/workflows/purge-cache.yml` does it
# automatically once these are set on the repository too.
#
# Both or neither. With either missing, `/api/cache/purge/` answers 404 rather
# than pretending, so a half-configured deployment cannot report a purge it
# never made.

# Cloudflare dashboard → the site → Overview, in the right-hand sidebar.
# Not a secret; it identifies the zone and authorises nothing.
CLOUDFLARE_ZONE_ID=""

# My Profile → API Tokens → Create Token → Custom token.
#   Permissions: Zone → Cache Purge → Purge
#   Zone Resources: Include → Specific zone → flexandflow.fit
# That is the whole grant: it can empty this one zone's cache and read nothing.
# Do NOT use the Global API Key — it carries the entire account.
CLOUDFLARE_API_TOKEN=""

# ── Intake form: Google Sheets export (optional) ───────────────────────────
#
# All three or none. With any missing, the intake form still saves every
# submission and still sends the WhatsApp notice — it just skips the Sheets
# append, logged on the submission row rather than thrown. See INTAKE-PLAN.md.
#
# 1. Google Cloud project with the Sheets API AND the Drive API both enabled
#    (separately — enabling one does not enable the other).
# 2. A service account in that project, with a JSON key downloaded.
# 3. The target Google Sheet SHARED with the service account's own email
#    (Share → paste the `...@project-id.iam.gserviceaccount.com` address →
#    Editor), done once by hand. Skipping this is the most likely mistake —
#    every API call 403s, and nothing here can tell you that happened; rows
#    simply never appear.

# From the service account's JSON key: "client_email".
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
# From the same JSON key: "private_key", pasted whole, including the
# -----BEGIN/END PRIVATE KEY----- lines. Same quoting trap as every other
# secret in this file (see the Xendit section above) — lib/env.ts unquotes
# and un-escapes it either way, but paste the value only if you can.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=""
# The id segment of the Sheet's URL, between /d/ and /edit.
GOOGLE_SHEET_ID=""

# ── Intake form: rate limit (optional) ──────────────────────────────────────
# How many submissions one IP address may make in a 10-minute window.
INTAKE_MAX_PER_IP_10MIN="3"

// Booking system schema. See BOOKING-PLAN.md §2 for the reasoning behind the
// shape of this — in particular why the booking catalogue lives here rather
// than being read out of `lib/data/services.ts`, and why the tier belongs to
// the therapist rather than being a separate choice in the wizard.
//
// Prisma 7: the datasource URL is not written here. It comes from
// `prisma.config.ts` at the repo root, which reads `DATABASE_URL`.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Ginny is MASTER, Yuni is STANDARD. The tier decides which `ServiceVariant`
/// price applies, which is why the wizard asks for the therapist first.
enum TherapistTier {
  MASTER
  STANDARD
}

enum BookingStatus {
  /// Held but not yet final. Still blocks its slot — see the exclusion constraint.
  PENDING
  /// Held while the customer pays. Blocks its slot exactly like PENDING, so
  /// nobody can take the time out from under someone at the payment screen.
  /// Swept back to CANCELLED by the cron when `holdExpiresAt` passes.
  AWAITING_PAYMENT
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum NotificationChannel {
  EMAIL
  WHATSAPP
}

enum NotificationKind {
  CUSTOMER_CONFIRMATION
  /// The receipt, on the pay-now path only. Queued by the settlement, never by
  /// the booking route — see `queueBookingCreated`.
  CUSTOMER_PAYMENT_RECEIVED
  ADMIN_NEW_BOOKING
  CUSTOMER_REMINDER
  CUSTOMER_CANCELLED
  ADMIN_CANCELLED
  CUSTOMER_RESCHEDULED
  ADMIN_RESCHEDULED
}

enum JobStatus {
  PENDING
  SENT
  FAILED
  /// Given up on. Either the retry budget ran out or the target is unreachable
  /// in a way retrying cannot fix (a number with no WhatsApp account).
  DEAD
}

/// How the customer said they would pay, chosen on the summary step.
enum PaymentMethod {
  /// Cash or card at the studio. The behaviour that shipped first, and still
  /// the default — nothing about it changed when online payment arrived.
  AT_STUDIO
  ONLINE
}

enum PaymentStatus {
  PENDING
  PAID
  EXPIRED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

/// Which Xendit product opened this charge. Kept because each one has its own
/// callback shape and its own fee, and the cost report in PAYMENT-PLAN §1 is
/// only answerable if the channel is recorded.
enum PaymentChannel {
  QRIS
  VIRTUAL_ACCOUNT
  CARD
  EWALLET
}

model Therapist {
  id String @id @default(cuid())

  /// Matches the slug in `lib/data/therapists.ts` so the wizard can reuse the
  /// portraits and bios that already ship with the site.
  slug String @unique

  name        String
  /// What the staff step shows, e.g. "Master Therapist - Ginny".
  displayName String
  tier        TherapistTier

  email     String?
  /// E.164. Where this therapist's own booking notifications go.
  phoneE164 String?
  photo     String?

  active    Boolean @default(true)
  sortOrder Int     @default(0)

  services     ServiceOnTherapist[]
  workingHours WorkingHour[]
  timeOff      TimeOff[]
  bookings     Booking[]

  @@index([active, sortOrder])
}

model ServiceCategory {
  id        String    @id @default(cuid())
  slug      String    @unique
  name      String
  sortOrder Int       @default(0)
  services  Service[]
}

model Service {
  id      String  @id @default(cuid())
  /// Matches `lib/data/services.ts` where the service exists there. Booking-only
  /// services may carry a slug that has no marketing page.
  slug    String  @unique
  title   String
  excerpt String?
  image   String?

  /// Clean-down time after the session. Stored on the booking's `endAt`, so the
  /// no-overlap constraint enforces it for free.
  bufferMinutes Int @default(15)

  active    Boolean @default(true)
  sortOrder Int     @default(0)

  categoryId String?
  category   ServiceCategory? @relation(fields: [categoryId], references: [id])

  variants   ServiceVariant[]
  therapists ServiceOnTherapist[]

  @@index([active, sortOrder])
}

/// One bookable (service × duration × tier) with its price.
model ServiceVariant {
  id        String  @id @default(cuid())
  serviceId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  tier            TherapistTier
  durationMinutes Int

  /// Whole rupiah as an integer — 750000, never 750000.00. Float money rounds
  /// wrong and prints wrong; there are no sub-rupiah prices to represent.
  priceIdr Int

  active Boolean @default(true)

  bookings Booking[]

  @@unique([serviceId, tier, durationMinutes])
  @@index([tier, active])
}

model ServiceOnTherapist {
  therapistId String
  serviceId   String
  therapist   Therapist @relation(fields: [therapistId], references: [id], onDelete: Cascade)
  service     Service   @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([therapistId, serviceId])
  @@index([serviceId])
}

/// Weekly working hours. More than one row per weekday is allowed and is how
/// the midday break appears: 09:00–12:00 and 14:00–17:00 leave a gap no slot
/// can straddle, which reproduces the old booking flow's Morning/Afternoon split.
model WorkingHour {
  id          String    @id @default(cuid())
  therapistId String
  therapist   Therapist @relation(fields: [therapistId], references: [id], onDelete: Cascade)

  /// 0 = Sunday … 6 = Saturday, in studio local time.
  weekday     Int
  /// Minutes since local midnight. 09:00 = 540.
  startMinute Int
  /// Minutes since local midnight. 12:00 = 720.
  endMinute   Int

  @@index([therapistId, weekday])
}

/// Leave, public holidays, ad-hoc blocks. A null `therapistId` closes the
/// studio for everyone.
model TimeOff {
  id          String     @id @default(cuid())
  therapistId String?
  therapist   Therapist? @relation(fields: [therapistId], references: [id], onDelete: Cascade)

  /// UTC, like every instant in this schema.
  startAt DateTime
  endAt   DateTime
  reason  String?

  createdAt DateTime @default(now())

  @@index([therapistId, startAt])
  @@index([startAt, endAt])
}

model Customer {
  id String @id @default(cuid())

  email     String?
  /// E.164, normalised by `libphonenumber-js` before it ever reaches here.
  /// Required: WhatsApp is how this studio actually reaches people.
  phoneE164 String

  firstName String
  lastName  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookings Booking[]

  @@index([phoneE164])
  @@index([email])
}

model Booking {
  id String @id @default(cuid())

  /// Short human-quotable code, e.g. "FF-8KQ2M". This is what goes in the
  /// WhatsApp message and the email subject.
  reference String @unique

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  therapistId String
  therapist   Therapist @relation(fields: [therapistId], references: [id])

  variantId String
  variant   ServiceVariant @relation(fields: [variantId], references: [id])

  /// UTC. `endAt` is start + duration + buffer, so the exclusion constraint
  /// keeps the clean-down gap without any application code remembering to.
  startAt DateTime
  endAt   DateTime

  status BookingStatus @default(CONFIRMED)
  note   String?

  /// Snapshotted at creation. The catalogue price may change later; what was
  /// printed in the customer's confirmation must not change with it.
  priceIdrAtBooking Int
  durationMinutes   Int
  bufferMinutes     Int @default(0)

  /// When an AWAITING_PAYMENT hold lapses. The cron sweeps past this and
  /// cancels, which is what frees the slot when somebody walks away from the
  /// payment screen. Null on a booking that was never held.
  holdExpiresAt DateTime?

  /// How the customer said they would pay. AT_STUDIO is the default and the
  /// path that shipped first; nothing about it changed when ONLINE arrived.
  paymentMethod PaymentMethod @default(AT_STUDIO)

  /// What must be paid online. Equal to the price for full prepayment, or the
  /// deposit when that is what the studio asks for. Zero for AT_STUDIO.
  ///
  /// Held apart from `amountPaidIdr` from the start so a deposit needs no
  /// second migration: the balance settled at the studio is the difference.
  amountDueIdr  Int @default(0)
  amountPaidIdr Int @default(0)

  payments Payment[]

  /// HMAC-signed opaque token. Lets the customer open the manage page and the
  /// .ics without an account, and stops anyone harvesting other people's
  /// appointments by guessing ids.
  manageToken String @unique

  /// Goes into the .ics SEQUENCE field. Bumped on every change so a reschedule
  /// updates the event already in the customer's calendar instead of adding a
  /// second one.
  icsSequence Int @default(0)

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  cancelledAt  DateTime?
  /// "customer" | "admin"
  cancelledBy  String?
  cancelReason String?

  notifications NotificationJob[]

  @@index([therapistId, startAt])
  @@index([startAt])
  @@index([status, startAt])
  @@index([customerId])
}

/// Outbound queue. The booking commits first and notifications follow, so a
/// WAHA session that has quietly logged out can never fail a customer's booking.
model NotificationJob {
  id        String  @id @default(cuid())
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  channel NotificationChannel
  kind    NotificationKind
  /// Email address or E.164 number.
  target  String

  status    JobStatus @default(PENDING)
  attempts  Int       @default(0)
  lastError String?

  /// When this may first be attempted. Reminders are queued at creation time
  /// with a date in the future; retries push this forward on each failure.
  scheduledAt DateTime  @default(now())
  sentAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Makes retrying idempotent — a booking can never send the same message
  /// twice on the same channel, however many times dispatch runs.
  @@unique([bookingId, channel, kind, target])
  @@index([status, scheduledAt])
}

/// One attempt to collect money for a booking.
///
/// A row per charge rather than a column on `Booking`, because a customer can
/// let a QRIS code expire and then pay by virtual account: two attempts, one
/// booking, and the failed one still has to be explicable afterwards.
model Payment {
  id        String  @id @default(cuid())
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  provider String @default("xendit")

  /// Our own reference, sent to Xendit as `external_id` / `reference_id`.
  ///
  /// Unique, and that is what makes the callback idempotent: Xendit retries
  /// until it gets a 200 and can deliver the same status twice, so the handler
  /// has to be able to recognise a charge it has already settled.
  providerRef String @unique

  /// Xendit's own id for the charge, used to re-fetch its status over the API.
  /// The callback body is never trusted on its own — see PAYMENT-PLAN §5.
  providerId String?

  channel PaymentChannel
  status  PaymentStatus  @default(PENDING)

  /// Whole rupiah, like every other amount in this schema.
  amountIdr     Int
  /// What actually arrived. Differs from `amountIdr` on a partial refund.
  amountPaidIdr Int @default(0)

  /// Rendered in our own modal rather than on a hosted page: the QRIS payload
  /// to draw, or the virtual account number to show. Null for card, which goes
  /// through Xendit's own UI because 3-D Secure belongs to the issuing bank.
  qrString    String?
  vaBank      String?
  vaNumber    String?
  /// Xendit's hosted page. The card path, and the fallback for every channel.
  checkoutUrl String?

  expiresAt DateTime?
  paidAt    DateTime?

  /// Refunds, recorded even when the money moved by hand — most Indonesian
  /// rails have no refund API, so this is often a note about a bank transfer
  /// somebody made. See PAYMENT-PLAN §8.
  refundedIdr Int       @default(0)
  refundedAt  DateTime?
  refundNote  String?

  /// The callback exactly as it arrived. When a customer disputes a payment,
  /// this is the evidence.
  rawPayload Json?
  lastError  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bookingId])
  @@index([status, expiresAt])
}

// ── CMS ────────────────────────────────────────────────────────────────────
// See CMS-PLAN.md §3. The body format is deliberately unchanged from
// `types/index.ts`: `ContentBlock[]` was already a block model, so the CMS
// stores that same union as JSON and `components/content/RichText.tsx` stays
// the only renderer on the public site.

enum ContentKind {
  SERVICE
  POST
}

enum ContentStatus {
  DRAFT
  PUBLISHED
}

/// A URL prefix, and the archive page that sits at it.
///
/// `/uluwatu-bali/` and `/injury-guide/` used to be two hand-written route
/// folders. They are rows now, served by `app/(main)/[category]/`, so the
/// studio can add a third without a deploy — which is what a CMS that owns its
/// own URLs has to be able to do.
///
/// Static route segments beat dynamic ones in Next, so `/services`, `/blog`,
/// `/about-us`, `/admin` and the rest keep their own files and are never
/// reachable through this. A category whose slug collides with one of them is
/// refused at write time; see `RESERVED_SLUGS` in `lib/cms/categories.ts`.
model ContentCategory {
  id   String @id @default(cuid())
  /// The URL segment. `/uluwatu-bali/…`
  slug String @unique

  /// What the archive page and the breadcrumbs call it.
  label String
  /// The visible sentence under the archive's title. Page copy, not metadata.
  lead  String?

  /// Yoast marks these archives `noindex, follow` and this app matches that.
  /// `seoDescription` is deliberately nullable: the injury-guide archive on
  /// WordPress emits no meta description at all, and inventing one would
  /// change what the archive says about itself.
  seoTitle       String
  seoDescription String?

  /// Cannot be renamed or removed from the panel.
  ///
  /// True for `uluwatu-bali`, which is where every treatment page lives —
  /// `lib/cms/read.ts` looks services up under that exact prefix, so renaming
  /// it would take all nine treatment pages off the internet at once.
  locked Boolean @default(false)

  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
}

/// One editable page — a treatment or a blog post.
///
/// One table for both, because they share a URL namespace:
/// `/uluwatu-bali/<slug>/` serves either, and `lib/content.ts` resolves which.
/// Slug uniqueness therefore has to hold *across* the pair — two tables with a
/// unique index each would happily allow a service and a post to claim the
/// same path, and one of them would become permanently unreachable.
model ContentDoc {
  id   String      @id @default(cuid())
  kind ContentKind

  slug String
  /// The path segment this is served under: "uluwatu-bali" for every service
  /// and for posts in that category, "injury-guide" for the rest. A post's URL
  /// comes from this, not from a folder.
  urlPrefix String

  status ContentStatus @default(DRAFT)

  /// Which revision the public site serves. Null means nothing is published —
  /// the page 404s and drops out of the sitemap.
  ///
  /// An integer rather than a foreign key on purpose. A `publishedRevisionId`
  /// pointing at `ContentRevision`, which points back here, is a circular
  /// reference that makes deleting a document an ordering puzzle for Postgres.
  /// The version number carries the same meaning with none of that.
  publishedVersion Int?
  publishedAt      DateTime?

  /// Reading order within the kind. Drives the sitemap, the "other treatments"
  /// sidebar and the blog listing — everything that used the plain order of
  /// the arrays in `lib/data/`.
  sortOrder Int @default(0)

  /// Position on `/services` and `/price-list`, which are ordered differently
  /// from the array — the WordPress grid led with the men's detox massage, not
  /// with assisted stretching.
  ///
  /// Two orderings because the site genuinely has two, and collapsing them
  /// would silently reshuffle one of the pages. Null means "not on the priced
  /// grid": posts, and the two services with no published rates
  /// (`full-body-massage`, `facial-massage`) which are deliberately off every
  /// menu while staying live and indexable.
  gridOrder Int?

  revisions ContentRevision[]

  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([urlPrefix, slug])
  @@index([kind, status, sortOrder])
}

/// One saved version of a document's content.
///
/// Append-only. The **draft** is the highest `version` for the document; the
/// **published** one is whichever `version` matches `ContentDoc.publishedVersion`.
/// That is what lets an editor work on a page without touching the live one,
/// with no branching in the reader and revision history for free.
model ContentRevision {
  id    String     @id @default(cuid())
  docId String
  doc   ContentDoc @relation(fields: [docId], references: [id], onDelete: Cascade)

  /// 1, 2, 3… per document. Allocated by `nextVersion` in `lib/cms/write.ts`.
  version Int

  title   String
  excerpt String

  /// Root-relative path (`/images/…`) or an absolute media URL. Optional
  /// because `Post.image` is — some ported posts have no featured image.
  image       String?
  /// Intrinsic size. `next/image` needs both, and the blog listing's packing
  /// reads them; an image inserted without them shifts the layout.
  imageWidth  Int?
  imageHeight Int?
  /// Two services carry an extra banner whose heading the theme hides.
  bannerImage String?

  /// `ContentBlock[]`, validated against `lib/cms/blocks.ts` on every write so
  /// a malformed block can never reach the renderer.
  body Json

  /// Yoast-ported metadata. Separate from `title` on purpose: changing a
  /// heading must not silently change the search result.
  seoTitle       String
  seoDescription String
  seoOgImage     String?
  canonicalPath  String

  /// Service only. `TherapistTier[]`. Prices stay editable here per the
  /// owner's decision (CMS-PLAN.md §10.2), which is why `npm run check:prices`
  /// remains the guard against `ServiceVariant`.
  tiers Json?
  /// Service only. The display label, e.g. "Duration : 1 hr".
  durationLabel String?

  /// Post only. The published date *as text*, e.g. "June 22, 2026" — that is
  /// what the original printed and what the ported copy contains, and parsing
  /// it into a `DateTime` would invent a timezone the source never had.
  displayDate String?

  /// Null once the author's account is hard-deleted; the byline falls back to
  /// the studio. Soft delete keeps the name (see `AdminUser.deletedAt`).
  authorId  String?
  createdAt DateTime @default(now())

  @@unique([docId, version])
  @@index([docId, createdAt])
}

/// Every uploaded or imported image, once.
model MediaAsset {
  id String @id @default(cuid())

  /// Root-relative for the files already shipped under `public/`, absolute for
  /// uploads. Always resolved against the configured public base rather than
  /// the bucket's own hostname, so changing storage provider moves no URL.
  url String @unique

  /// SHA-256 of the bytes. Uploading the same file twice returns the existing
  /// row instead of storing it again — the brief asks for exactly that.
  checksum String @unique

  filename String
  mimeType String
  bytes    Int
  width    Int?
  height   Int?
  /// Default alt text. A block may override it for its own use.
  alt      String @default("")

  /// True for the files that shipped with the repo under `public/`. They are
  /// referenced by ported copy and cannot be deleted from the library — the
  /// file would still be in the build, and the row is what makes it pickable.
  builtIn Boolean @default(false)

  uploadedById String?
  createdAt    DateTime @default(now())

  @@index([createdAt])
}

/// What an admin may do, before per-user grants are applied.
///
/// Nothing in this codebase branches on the role itself — it branches on
/// `can()` — so adding one is an entry in `ROLE_PERMISSIONS`
/// (`lib/admin/permissions.ts`) and a value here, with no call site to change.
/// `BOOKING_STAFF` was added that way and needed nothing else.
///
/// The three do not overlap by design: `EDITOR` cannot see a customer's phone
/// number and `BOOKING_STAFF` cannot change a word on the website. Anything
/// beyond a role's defaults is granted per person through
/// `AdminUser.extraPermissions`.
enum AdminRole {
  SUPER_ADMIN
  /// Website content: treatments and blog posts. No access to bookings.
  EDITOR
  /// The diary: bookings, schedule and the prices the wizard charges. No
  /// access to website content.
  BOOKING_STAFF
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  lastLoginAt  DateTime?

  /// New accounts are editors. The migration that added this column sets every
  /// row that already existed to SUPER_ADMIN explicitly — letting the default
  /// apply would have demoted the owner's own account and locked them out of
  /// the page that grants the role back.
  role AdminRole @default(EDITOR)

  /// Capabilities granted on top of the role's defaults, e.g. giving one
  /// editor `content.publish` without making them a super admin. The brief
  /// asks for exactly this ("kecuali diberikan permission secara khusus").
  /// Unknown strings are ignored rather than trusted — see `permissionsFor`.
  extraPermissions String[] @default([])

  /// Soft delete. An account that authored a revision cannot be removed
  /// outright or the author of published content stops resolving; those are
  /// struck through here instead. Accounts that never wrote anything are
  /// deleted for real.
  deletedAt DateTime?

  updatedAt DateTime @default(now()) @updatedAt

  @@index([deletedAt, active])
}

model AuditLog {
  id       String @id @default(cuid())
  actor    String
  action   String
  entity   String
  entityId String
  meta     Json?

  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}
